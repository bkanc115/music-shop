APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Подключение к PostgreSQL
POSTGRES_USER=musicshop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=musicshop
DATABASE_URL=postgresql+psycopg://musicshop:CHANGE_ME@127.0.0.1:5432/musicshop

# Ключ подписи токенов авторизации 
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# Журналирование
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Начальный администратор (первичное заполнение БД)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME